# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore).

# --- Supabase (Project Settings → API) ---
# Públicas: se pueden ver en el navegador, por eso llevan NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pega-aqui-la-anon-key
# SECRETA: salta las reglas de seguridad de la base. Solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key

# --- Máquina ---
# Clave que la máquina envía en "Authorization: Bearer ...".
# Genera una larga y aleatoria con:  openssl rand -base64 32
MACHINE_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Simulador ---
# Correos que pueden entrar a /simulador, separados por comas.
OPERATOR_EMAILS=operador1@ejemplo.cl,operador2@ejemplo.cl

# --- Sitio ---
# URL base (para los enlaces del login por correo).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

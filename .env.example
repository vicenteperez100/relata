# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore).

# --- Supabase (Project Settings → API Keys) ---
# Públicas: se ven en el navegador, por eso llevan NEXT_PUBLIC_.
# Son seguras de exponer porque el RLS de la base protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# SECRETA: se salta las reglas de seguridad. Solo en el servidor. Nunca la compartas.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Máquina ---
# Clave que la máquina envía en "Authorization: Bearer ...". Mínimo 32 caracteres.
# Genera una con:  openssl rand -base64 32
MACHINE_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Simulador ---
# Correos que pueden entrar a /simulador, separados por comas.
OPERATOR_EMAILS=operador1@ejemplo.cl,operador2@ejemplo.cl

# --- Sitio ---
# URL base (para los enlaces del login por correo).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
